---
interface Props {
  label: string;
  judul: string;
}
const { label, judul } = Astro.props;
---

<div class="mb-7 flex flex-wrap items-end justify-between gap-5">
  <div>
    <span class="label-mono mb-2.5 block text-water">{label}</span>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold">{judul}</h2>
  </div>
  <p class="max-w-[46ch] text-muted"><slot /></p>
</div>
