---
import { destinasi } from '../data/destinasi';
import { situs } from '../config/site';
import Foto from './Foto.astro';
import JudulBagian from './JudulBagian.astro';

// Tombol filter dibuat otomatis dari kategori yang ada di data/destinasi.ts
const kategori = ['Semua', ...new Set(destinasi.map((d) => d.kategori))];
---

<section id="destinasi" class="pt-14 pb-2 md:pt-19">
  <JudulBagian label="Kluster 1 · Katalog wisata" judul="Destinasi di Mayangan">
    Pilih titik yang ingin dikunjungi. Ketuk foto untuk melihat detail dan durasi kunjungan.
  </JudulBagian>

  <div class="mb-5.5 flex flex-wrap gap-2" role="group" aria-label="Filter destinasi">
    {
      kategori.map((k) => (
        <button
          type="button"
          data-chip={k}
          aria-pressed={k === 'Semua' ? 'true' : 'false'}
          class="cursor-pointer rounded-full border-[1.5px] border-line bg-surface px-3.75 py-2.5 text-sm leading-none font-semibold text-ink aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-brand-ink"
        >
          {k}
        </button>
      ))
    }
  </div>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-4">
    {
      destinasi.map((d) => (
        <button
          type="button"
          data-tile
          data-kategori={d.kategori}
          data-nama={d.nama}
          data-deskripsi={d.deskripsi}
          data-durasi={d.durasi}
          class="tile flex cursor-pointer flex-col overflow-hidden rounded-2xl bg-surface text-left text-ink shadow-card"
        >
          <div class="bingkai zoom aspect-4/3 overflow-hidden bg-chip">
            <Foto jenis="destinasi" id={d.id} alt={d.nama} adegan={d.adegan} />
          </div>
          <div class="flex flex-1 flex-col gap-1.5 px-4 pt-3.5 pb-4">
            <span class="label-mono text-water">{d.kategori}</span>
            <h3 class="text-xl">{d.nama}</h3>
            <p class="text-[14.5px] text-muted">{d.ringkas}</p>
            <span class="mt-auto pt-1.5 text-[13px] text-muted">Durasi: {d.durasi}</span>
          </div>
        </button>
      ))
    }
  </div>

  {situs.catatanContoh.destinasi && <p class="mt-4 text-[13px] text-muted">{situs.catatanContoh.destinasi}</p>}

  <!-- Jendela detail (muncul saat kartu diketuk) -->
  <dialog
    id="dlg"
    aria-label="Detail destinasi"
    class="m-auto max-h-[calc(100dvh-2rem)] w-[min(760px,calc(100vw-2rem))] overflow-auto rounded-[20px] border-0 bg-surface p-0 text-ink shadow-2xl backdrop:bg-black/70"
  >
    <div class="relative">
      <button type="button" id="dlg-tutup" class="btn btn-sm absolute top-3 right-3 z-10" aria-label="Tutup">Tutup</button>
      <div id="dlg-foto" class="bingkai aspect-4/3 bg-chip sm:aspect-16/10"></div>
      <div class="grid gap-2.5 px-5.5 pt-5 pb-5.5">
        <span id="dlg-kategori" class="label-mono text-water"></span>
        <h3 id="dlg-nama" class="text-[28px]"></h3>
        <p id="dlg-deskripsi" class="text-muted"></p>
        <div class="mt-1.5 flex flex-wrap items-center justify-between gap-2.5">
          <span id="dlg-meta" class="text-sm text-muted"></span>
          <div class="flex gap-2">
            <button type="button" id="dlg-sebelumnya" class="btn btn-sm btn-ghost">&larr; Sebelumnya</button>
            <button type="button" id="dlg-berikutnya" class="btn btn-sm btn-ghost">Berikutnya &rarr;</button>
          </div>
        </div>
        <a class="btn btn-brand justify-self-start" href="#paket" id="dlg-paket">Lihat paket yang mencakup ini</a>
      </div>
    </div>
  </dialog>
</section>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chip]'));
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tile]'));
  const dlg = document.getElementById('dlg') as HTMLDialogElement;
  const el = (id: string) => document.getElementById(id) as HTMLElement;

  let daftar: HTMLButtonElement[] = tiles;
  let posisi = 0;

  // Filter kategori
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const k = chip.dataset.chip;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      tiles.forEach((t) => {
        t.hidden = !(k === 'Semua' || t.dataset.kategori === k);
      });
    });
  });

  // Isi jendela detail dari kartu yang dipilih
  function tampil(i: number) {
    daftar = tiles.filter((t) => !t.hidden);
    posisi = (i + daftar.length) % daftar.length;
    const t = daftar[posisi];
    const bingkai = t.querySelector('.bingkai');
    // beri akhiran pada id agar gradien SVG tidak bentrok dengan kartu aslinya
    const html = (bingkai?.innerHTML ?? '')
      .replace(/id="([^"]+)"/g, 'id="$1-d"')
      .replace(/url\(#([^)]+)\)/g, 'url(#$1-d)');
    el('dlg-foto').innerHTML = html;
    el('dlg-kategori').textContent = t.dataset.kategori ?? '';
    el('dlg-nama').textContent = t.dataset.nama ?? '';
    el('dlg-deskripsi').textContent = t.dataset.deskripsi ?? '';
    el('dlg-meta').textContent = `Durasi kunjungan: ${t.dataset.durasi}  ·  ${posisi + 1} dari ${daftar.length}`;
  }

  tiles.forEach((t) => {
    t.addEventListener('click', () => {
      daftar = tiles.filter((x) => !x.hidden);
      tampil(daftar.indexOf(t));
      dlg.showModal();
    });
  });

  el('dlg-tutup').addEventListener('click', () => dlg.close());
  el('dlg-sebelumnya').addEventListener('click', () => tampil(posisi - 1));
  el('dlg-berikutnya').addEventListener('click', () => tampil(posisi + 1));
  el('dlg-paket').addEventListener('click', () => dlg.close());
  // klik di area gelap di luar kotak = tutup
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>
